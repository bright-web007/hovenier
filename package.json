{
  "name": "hovenier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:schema": "jest --testNamePattern='Schema'",
    "test:pages": "jest --testPathPattern='__tests__/pages/'",
    "test:static": "jest __tests__/pages/static-pages.test.tsx",
    "test:services": "jest __tests__/pages/service-pages.test.tsx",
    "test:regional": "jest __tests__/pages/regional-pages.test.tsx",
    "test:api": "jest __tests__/pages/api-error-pages.test.tsx",
    "test:gardeners": "jest __tests__/pages/gardener-pages.test.tsx",
    "test:integration": "jest __tests__/integration.test.tsx",
    "test:coverage": "jest --coverage",
    "test:all": "npm run test:schema && npm run test:pages",
    "validate:pre-deploy": "npm run lint && npm run test && npm run build",
    "validate:server-components": "npm run lint -- --no-ignore app/\\*\\*/page.tsx",
    "indexnow": "node scripts/indexnow-submit.js",
    "env:check": "node scripts/validate-env.js",
    "env:setup": "cp .env.example .env.local && echo 'Created .env.local from template. Please fill in your values.'",
    "postinstall": "npm run env:check || echo 'Warning: Environment validation failed. Run npm run env:setup to get started.'"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.4.2",
    "@sentry/nextjs": "^10.45.0",
    "next": "16.2.1",
    "next-intl": "^4.8.3",
    "next-sitemap": "^4.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-ga4": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20",
    "@types/node-fetch": "2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
